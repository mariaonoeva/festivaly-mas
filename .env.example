# Zkopíruj na .env (je v .gitignore) a doplň hodnoty. Do gitu jen tento soubor bez hodnot.
# Jiné klíče pro vývoj a pro produkci.

# Průzkumník (Exa)
EXA_API_KEY=

# Extraktor (Nominatim vyžaduje kontakt)
NOMINATIM_CONTACT_EMAIL=

# Chatbot (Google AI Studio, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Záloha při přetížení hlavního modelu (HTTP 503); prázdné = bez zálohy
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Náhodný řetězec pro hashování IP klientů (ukládá se jen hash)
CHAT_CLIENT_SALT=
# Domény webu, které smí chatbot volat (CORS), oddělené čárkou
CHAT_ALLOWED_ORIGINS=https://festivaly-mas.vercel.app,http://127.0.0.1:3000
# 1 jen když běží za reverzní proxy, která nastavuje X-Forwarded-For
CHAT_TRUST_PROXY=0

# Limity (útok na peněženku)
CHAT_PER_CLIENT_PER_MINUTE=6
CHAT_PER_CLIENT_PER_DAY=60
CHAT_LLM_CALLS_PER_DAY=300
CHAT_ADHOC_PER_DAY=20

# Web (Next.js). Jen veřejná adresa backendu chatbota, žádný klíč.
# Lokálně ji dej do .env.local, na Vercelu do Environment Variables.
NEXT_PUBLIC_CHAT_API_URL=http://127.0.0.1:8787
